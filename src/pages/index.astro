---
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Differentials from '../components/sections/Differentials.astro';
import Process from '../components/sections/Process.astro';
import Treatments from '../components/sections/Treatments.astro';
import Clinic from '../components/sections/Clinic.astro';
import Credentials from '../components/sections/Credentials.astro';
import Faq from '../components/sections/Faq.astro';
import FinalCta from '../components/sections/FinalCta.astro';
import { dentistSchema, faqSchema } from '../lib/schema';
---

<Base schemas={[dentistSchema(), faqSchema()]}>
  <Hero />
  <About />
  <Differentials />
  <Process />
  <Treatments />
  <Clinic />
  <Credentials />
  <Faq />
  <FinalCta />
</Base>
