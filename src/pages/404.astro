---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base title="Página não encontrada | Odonto Silva" noindex>
  <section class="container nf">
    <h1>Essa página não existe.</h1>
    <p class="lead">Pode ter mudado de lugar. O resto do site continua aqui.</p>
    <Button href="/">Voltar para o início</Button>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(80px, 12vw, 180px);
    display: grid;
    justify-items: start;
    gap: 24px;
  }
  .nf h1 {
    font-size: var(--t-h2);
  }
</style>
