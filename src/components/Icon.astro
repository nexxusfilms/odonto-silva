---
/**
 * Ícones de linha para dados de contato. Decorativos: o texto ao lado
 * já diz o que é, então ficam fora da leitura de tela.
 */
interface Props {
  name: 'whatsapp' | 'instagram' | 'google' | 'pin';
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  width={size}
  height={size}
  aria-hidden="true"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  {
    name === 'whatsapp' && (
      <>
        <path d="M3.5 20.5l1.3-4.3A8.5 8.5 0 1 1 8 19.3l-4.5 1.2Z" />
        <path d="M9 8.6c.2-.5.5-.6.8-.6h.5c.2 0 .3.1.4.3l.7 1.6c.1.2 0 .4-.1.5l-.5.6c-.1.1-.1.3 0 .4.6 1 1.4 1.8 2.4 2.4.1.1.3.1.4 0l.6-.5c.1-.1.3-.2.5-.1l1.6.7c.2.1.3.2.3.4v.5c0 .3-.1.6-.6.8-.7.3-1.6.4-2.6-.1a9.4 9.4 0 0 1-4.3-4.3c-.5-1-.4-1.9-.1-2.6Z" />
      </>
    )
  }
  {
    name === 'instagram' && (
      <>
        <rect x="3.5" y="3.5" width="17" height="17" rx="4.5" />
        <circle cx="12" cy="12" r="4" />
        <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" stroke="none" />
      </>
    )
  }
  {
    name === 'google' && (
      <path d="m12 3.8 2.5 5.1 5.6.8-4 3.9.9 5.6-5-2.6-5 2.6.9-5.6-4-3.9 5.6-.8L12 3.8Z" />
    )
  }
  {
    name === 'pin' && (
      <>
        <path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" />
        <circle cx="12" cy="10" r="2.4" />
      </>
    )
  }
</svg>

<style>
  .icon {
    flex: none;
  }
</style>
