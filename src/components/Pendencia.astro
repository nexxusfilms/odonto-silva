---
import { flags } from '../config/flags';

interface Props {
  texto?: string;
  /** Mostra mesmo com `mostrarPendencias` desligado (páginas em revisão). */
  forcar?: boolean;
  rotulo?: string;
}

const { texto, forcar = false, rotulo = 'VALIDAR' } = Astro.props;
---

{(flags.mostrarPendencias || forcar) && texto && <span class="pendencia">{rotulo}: {texto}</span>}
