---
/**
 * Aviso de cookies (LGPD). Discreto, no canto da tela, sem bloquear a
 * navegação. "Recusar" tem o mesmo peso visual de "Aceitar", como orienta
 * a ANPD.
 * Qualquer elemento com `data-cookies-abrir` reabre o aviso (rodapé e
 * política de privacidade).
 */
---

<section class="cookies" data-cookies aria-labelledby="cookies-titulo" hidden>
  <h2 id="cookies-titulo" class="cookies__titulo">Cookies</h2>
  <p class="cookies__texto">
    Usamos cookies para entender como o site é visitado e medir os anúncios. Só ativamos se você aceitar.
    <a href="/politica-de-privacidade#cookies">Saiba mais</a>
  </p>

  <form class="cookies__opcoes" data-cookies-opcoes hidden>
    <label>
      <input type="checkbox" checked disabled />
      <span><strong>Necessários</strong> Guardam a sua escolha sobre cookies. Sempre ativos.</span>
    </label>
    <label>
      <input type="checkbox" name="estatistica" />
      <span><strong>Estatísticas</strong> Quantas pessoas visitam e quais páginas leem (Google Analytics).</span>
    </label>
    <label>
      <input type="checkbox" name="anuncios" />
      <span><strong>Anúncios</strong> Medem se os anúncios no Google e no Instagram trouxeram você até aqui.</span>
    </label>
  </form>

  <div class="cookies__acoes">
    <button type="button" class="cookies__btn cookies__btn--forte" data-cookies-acao="recusar" data-track="cookies_recusar">Recusar</button>
    <button type="button" class="cookies__btn cookies__btn--link" data-cookies-acao="personalizar" data-track="cookies_personalizar">
      Personalizar
    </button>
    <button type="button" class="cookies__btn" data-cookies-acao="salvar" data-track="cookies_salvar" hidden>
      Salvar escolhas
    </button>
    <button type="button" class="cookies__btn cookies__btn--forte" data-cookies-acao="aceitar" data-track="cookies_aceitar">
      Aceitar
    </button>
  </div>
</section>

<script>
  import { lerEscolha, salvarEscolha } from '../lib/consentimento';

  const aviso = document.querySelector<HTMLElement>('[data-cookies]');
  if (aviso) {
    const opcoes = aviso.querySelector<HTMLFormElement>('[data-cookies-opcoes]')!;
    const botao = (acao: string) => aviso.querySelector<HTMLButtonElement>(`[data-cookies-acao="${acao}"]`)!;

    const modoOpcoes = (ligado: boolean) => {
      opcoes.hidden = !ligado;
      botao('personalizar').hidden = ligado;
      botao('salvar').hidden = !ligado;
    };
    const abrir = (comOpcoes = false) => {
      const atual = lerEscolha();
      (opcoes.elements.namedItem('estatistica') as HTMLInputElement).checked = !!atual?.estatistica;
      (opcoes.elements.namedItem('anuncios') as HTMLInputElement).checked = !!atual?.anuncios;
      modoOpcoes(comOpcoes);
      aviso.hidden = false;
      document.documentElement.classList.add('cookies-aberto');
    };
    const fechar = (estatistica: boolean, anuncios: boolean) => {
      salvarEscolha(estatistica, anuncios);
      aviso.hidden = true;
      document.documentElement.classList.remove('cookies-aberto');
    };

    aviso.addEventListener('click', (ev) => {
      const acao = (ev.target as Element).closest<HTMLElement>('[data-cookies-acao]')?.dataset.cookiesAcao;
      if (acao === 'aceitar') fechar(true, true);
      if (acao === 'recusar') fechar(false, false);
      if (acao === 'personalizar') {
        modoOpcoes(true);
        opcoes.querySelector<HTMLInputElement>('input:not([disabled])')?.focus();
      }
      if (acao === 'salvar') {
        const f = opcoes.elements;
        fechar((f.namedItem('estatistica') as HTMLInputElement).checked, (f.namedItem('anuncios') as HTMLInputElement).checked);
      }
    });

    document.addEventListener('click', (ev) => {
      if (!(ev.target as Element).closest('[data-cookies-abrir]')) return;
      ev.preventDefault();
      abrir(true);
      aviso.querySelector<HTMLElement>('input:not([disabled])')?.focus();
    });

    if (!lerEscolha()) abrir();
  }
</script>

<style>
  .cookies {
    position: fixed;
    left: max(16px, env(safe-area-inset-left));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 50;
    width: min(400px, calc(100vw - 32px));
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: 20px 20px 18px;
    background: var(--branco);
    border: 1px solid var(--linha);
    border-top: 3px solid var(--rosa-profundo);
    border-radius: var(--raio);
    box-shadow: 0 12px 40px rgb(17 17 17 / 0.12);
    font-size: var(--t-small);
    line-height: 1.55;
  }
  .cookies[hidden] {
    display: none;
  }
  .cookies__titulo {
    font-size: 1rem;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }
  .cookies__texto a {
    color: var(--rosa-profundo);
    text-underline-offset: 3px;
    white-space: nowrap;
  }
  .cookies__opcoes {
    display: grid;
    gap: 12px;
    margin-top: 16px;
    padding-top: 16px;
    border-top: 1px solid var(--linha);
  }
  .cookies__opcoes[hidden] {
    display: none;
  }
  .cookies__opcoes label {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 10px;
    align-items: start;
    cursor: pointer;
  }
  .cookies__opcoes input {
    width: 18px;
    height: 18px;
    margin: 2px 0 0;
    accent-color: var(--rosa-profundo);
  }
  .cookies__opcoes strong {
    display: block;
    color: var(--tinta);
    font-weight: 600;
  }
  .cookies__acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 16px;
  }
  .cookies__btn {
    flex: 1 1 auto;
    min-height: 44px;
    padding: 0 16px;
    border: 1.5px solid var(--tinta);
    border-radius: var(--raio);
    background: var(--branco);
    color: var(--tinta);
    font: 600 0.9375rem var(--f-titulo);
    cursor: pointer;
    transition:
      background-color 250ms var(--ease),
      color 250ms var(--ease);
  }
  .cookies__btn[hidden] {
    display: none;
  }
  .cookies__btn:hover,
  .cookies__btn--forte {
    background: var(--tinta);
    color: var(--branco);
  }
  .cookies__btn--forte:hover {
    background: var(--branco);
    color: var(--tinta);
  }
  .cookies__btn {
    flex: 1 1 0;
  }
  [data-cookies-acao='salvar'] {
    order: 1;
    flex-basis: 100%;
  }
  .cookies__btn--link,
  .cookies__btn--link:hover {
    order: 1;
    flex: 0 0 auto;
    min-height: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--tinta);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* No celular o aviso ocupa a largura toda; o botão flutuante espera. */
  @media (max-width: 639px) {
    :global(html.cookies-aberto .wa-float) {
      visibility: hidden;
    }
  }
</style>
