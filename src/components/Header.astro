---
import logo from '../assets/brand/logo.svg';
import Button from './Button.astro';
import { nav, baseDoMenu } from '../config/nav';

const base = baseDoMenu(Astro.url.pathname);
---

<header class="header" data-header>
  <div class="container header__bar">
    <a href="/" class="header__logo" data-track="cabecalho_logo" aria-label="Odonto Silva, página inicial">
      <img src={logo.src} width="560" height="360" alt="Odonto Silva" />
    </a>

    <nav class="header__nav" aria-label="Principal">
      <ul>
        {nav.map((item) => <li><a href={`${base}${item.href}`}>{item.label}</a></li>)}
      </ul>
    </nav>

    <div class="header__actions">
      <Button whatsapp size="sm" class="header__cta" track="cabecalho_agendar_whatsapp">Agendar consulta</Button>
      <button
        class="header__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="menu-mobile"
        data-menu-toggle>
        <span class="header__toggle-label">Menu</span>
        <span class="header__toggle-icon" aria-hidden="true"><i></i><i></i></span>
      </button>
    </div>
  </div>

  <div class="menu" id="menu-mobile" data-menu hidden>
    <nav class="container" aria-label="Principal (celular)">
      <ul>
        {nav.map((item) => <li><a href={`${base}${item.href}`} data-menu-link>{item.label}</a></li>)}
      </ul>
      <Button whatsapp size="lg" class="menu__cta" track="menu_agendar_whatsapp">Agendar pelo WhatsApp</Button>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menu = document.querySelector<HTMLElement>('[data-menu]')!;

  const setOpen = (open: boolean) => {
    toggle.setAttribute('aria-expanded', String(open));
    menu.hidden = !open;
    header.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  };

  toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--branco);
    border-bottom: 1px solid transparent;
    transition: border-color 300ms var(--ease);
  }
  .header.is-scrolled {
    border-bottom-color: var(--linha);
  }
  .header__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--header-h);
  }
  .header__logo {
    display: block;
    flex: none;
  }
  .header__logo img {
    height: 54px;
    width: auto;
  }

  .header__nav ul {
    display: flex;
    gap: clamp(18px, 2.2vw, 34px);
  }
  .header__nav a {
    position: relative;
    font-size: 0.9375rem;
    color: var(--texto);
    text-decoration: none;
    padding-block: 8px;
  }
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 2px;
    height: 2px;
    background: var(--rosa);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms var(--ease);
  }
  .header__nav a:hover::after {
    transform: scaleX(1);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .header__toggle {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    padding: 0 4px 0 10px;
    border: 0;
    background: none;
    font: 500 0.9375rem var(--f-texto);
    color: var(--tinta);
    cursor: pointer;
  }
  .header__toggle-icon {
    display: grid;
    gap: 6px;
    width: 22px;
  }
  .header__toggle-icon i {
    display: block;
    height: 2px;
    background: currentColor;
    transition: transform 300ms var(--ease);
  }
  .is-open .header__toggle-icon i:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .is-open .header__toggle-icon i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--branco);
    overflow-y: auto;
    padding-block: 24px 40px;
  }
  .menu ul {
    display: grid;
  }
  .menu li + li {
    border-top: 1px solid var(--linha);
  }
  .menu a[data-menu-link] {
    display: block;
    padding: 18px 0;
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 1.75rem;
    letter-spacing: -0.03em;
    color: var(--tinta);
    text-decoration: none;
  }
  .menu :global(.menu__cta) {
    width: 100%;
    margin-top: 28px;
  }

  @media (max-width: 1023px) {
    .header__nav {
      display: none;
    }
    .header__toggle {
      display: inline-flex;
    }
  }
  @media (max-width: 559px) {
    .header__actions :global(.header__cta) {
      display: none;
    }
    .header__logo img {
      height: 42px;
    }
  }
  @media (min-width: 1024px) {
    .menu {
      display: none;
    }
  }
</style>
