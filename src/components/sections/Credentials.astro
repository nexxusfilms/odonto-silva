---
/**
 * Autoridade: só informação comprovada (formação, CRO, RQE).
 * As avaliações ficam na seção seguinte (Reviews.astro).
 */
import { credenciais } from '../../content/home';
import { site } from '../../config/site';
import Pendencia from '../Pendencia.astro';

const p = site.profissional;
const linhas: { termo: string; valor: string; validar?: string }[] = [
  { termo: 'Nome', valor: p.nomeCompleto },
  { termo: 'Registro', valor: `CRO-SP ${p.cro}` },
  ...credenciais.itens,
];
---

<section id="formacao" class="section cred" aria-labelledby="cred-titulo">
  <div class="container cred__grid">
    <header class="cred__head">
      <span class="kicker">{credenciais.kicker}</span>
      <h2 id="cred-titulo" class="h2">{credenciais.titulo}</h2>
      <p class="cred__intro">{credenciais.intro}</p>
    </header>

    <dl class="cred__list">
      {
        linhas.map((l) => (
          <div>
            <dt>{l.termo}</dt>
            <dd>
              {l.valor}
              {l.validar && (
                <>
                  <br />
                  <Pendencia texto={l.validar} />
                </>
              )}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .cred__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }
  .cred__head {
    grid-column: 1 / span 5;
  }
  .cred__intro {
    margin-top: 20px;
    max-width: 30rem;
    color: var(--texto);
  }
  .cred__list {
    grid-column: 7 / span 6;
    margin: 8px 0 0;
    border-top: 1.5px solid var(--tinta);
  }
  .cred__list div {
    display: grid;
    grid-template-columns: minmax(120px, 1fr) 2fr;
    gap: 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--linha);
  }
  .cred__list dt {
    font-size: var(--t-small);
    color: var(--texto-suave);
  }
  .cred__list dd {
    margin: 0;
    min-width: 0;
    color: var(--tinta);
    font-weight: 500;
  }

  @media (max-width: 1023px) {
    .cred__grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
    .cred__head,
    .cred__list {
      grid-column: 1;
    }
  }
  @media (max-width: 559px) {
    .cred__list div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
