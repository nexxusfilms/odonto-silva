---
/**
 * Autoridade: só informação comprovada (formação, CRO, RQE).
 * Avaliações: o Planejamento coloca o Google como principal fator de
 * escolha (85%). Em vez de depoimentos no site (zona cinza no CFO),
 * o site leva o paciente às avaliações públicas.
 */
import { credenciais, avaliacoes } from '../../content/home';
import { site, isFilled } from '../../config/site';
import Button from '../Button.astro';

const p = site.profissional;
const linhas = [
  { termo: 'Nome', valor: p.nomeCompleto },
  { termo: 'Registro', valor: `CRO-SP ${p.cro}` },
  ...credenciais.itens,
];
const linkAvaliacoes = isFilled(site.links.googleAvaliacoes) ? site.links.googleAvaliacoes : '#';
---

<section id="formacao" class="section cred" aria-labelledby="cred-titulo">
  <div class="container cred__grid">
    <div class="cred__main">
      <span class="kicker">{credenciais.kicker}</span>
      <h2 id="cred-titulo" class="h2">{credenciais.titulo}</h2>
      <p class="cred__intro">{credenciais.intro}</p>

      <dl class="cred__list">
        {
          linhas.map((l) => (
            <div>
              <dt>{l.termo}</dt>
              <dd>{l.valor}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <aside class="cred__reviews" aria-labelledby="reviews-titulo">
      <h3 id="reviews-titulo" class="cred__reviews-title">{avaliacoes.titulo}</h3>
      <p>{avaliacoes.texto}</p>
      <Button href={linkAvaliacoes} variant="ghost">{avaliacoes.cta}</Button>

      <p class="cred__placeholder">{avaliacoes.depoimentosPlaceholder}</p>

      <p class="cred__ask">{avaliacoes.pedido}</p>
      <Button href={linkAvaliacoes} variant="text">{avaliacoes.ctaPedido}</Button>
    </aside>
  </div>
</section>

<style>
  .cred__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }
  .cred__main {
    grid-column: 1 / span 7;
  }
  .cred__intro {
    margin-top: 20px;
    max-width: 34rem;
    color: var(--texto);
  }
  .cred__list {
    margin: clamp(40px, 5vw, 56px) 0 0;
    border-top: 1.5px solid var(--tinta);
  }
  .cred__list div {
    display: grid;
    grid-template-columns: minmax(140px, 1fr) 2fr;
    gap: 16px;
    padding-block: 18px;
    border-bottom: 1px solid var(--linha);
  }
  .cred__list dt {
    font-size: var(--t-small);
    color: var(--texto-suave);
  }
  .cred__list dd {
    margin: 0;
    color: var(--tinta);
    font-weight: 500;
  }

  .cred__reviews {
    grid-column: 9 / span 4;
    margin-top: clamp(0px, 6vw, 96px);
    padding: clamp(28px, 3vw, 40px);
    background: var(--nevoa-rosa);
    display: grid;
    justify-items: start;
    gap: 16px;
  }
  .cred__reviews-title {
    font-size: 1.5rem;
  }
  .cred__placeholder {
    width: 100%;
    margin-top: 8px;
    padding: 20px;
    border: 1px dashed var(--rosa-profundo);
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: var(--rosa-profundo);
  }
  .cred__ask {
    margin-top: 8px;
    font-size: var(--t-small);
  }

  @media (max-width: 1023px) {
    .cred__grid {
      grid-template-columns: 1fr;
      row-gap: 56px;
    }
    .cred__main,
    .cred__reviews {
      grid-column: 1;
      margin-top: 0;
    }
  }
  @media (max-width: 559px) {
    .cred__list div {
      grid-template-columns: 1fr;
      gap: 4px;
    }
  }
</style>
