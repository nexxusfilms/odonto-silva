---
import { ctaFinal } from '../../content/home';
import { site } from '../../config/site';
import Button from '../Button.astro';
import Brush from '../Brush.astro';
---

<section id="contato" class="section final" data-cta-final aria-labelledby="final-titulo">
  <Brush shape="arc" color="rosa" class="final__arc" />
  <div class="container final__inner">
    <h2 id="final-titulo" class="final__title">
      <span>{ctaFinal.titulo[0]}</span>
      <span class="rosa">{ctaFinal.titulo[1]}</span>
    </h2>
    <p class="lead final__text">{ctaFinal.texto}</p>
    <Button whatsapp size="lg">{ctaFinal.cta}</Button>
    <p class="final__meta">
      {site.endereco.bairro}, {site.endereco.cidade} · {site.telefone}
    </p>
  </div>
</section>

<style>
  .final {
    overflow: clip;
    padding-block: clamp(96px, 10vw, 176px);
  }
  .final :global(.final__arc) {
    position: absolute;
    width: clamp(220px, 34vw, 520px);
    right: -6%;
    bottom: -18%;
    transform: rotate(-24deg);
  }
  .final__inner {
    position: relative;
  }
  .final__title {
    font-size: var(--t-h1);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    max-width: 15ch;
  }
  .final__title span {
    display: block;
  }
  .final__text {
    max-width: 34rem;
    margin: clamp(24px, 3vw, 36px) 0 clamp(32px, 3.5vw, 44px);
  }
  .final__meta {
    margin-top: 20px;
    font-size: var(--t-small);
    color: var(--texto-suave);
  }
  @media (max-width: 559px) {
    .final :global(.final__arc) {
      width: 200px;
      right: -70px;
      bottom: -60px;
    }
    .final :global(.btn) {
      width: 100%;
    }
  }
</style>
