---
import { faq, faqIntro } from '../../content/faq';
import Pendencia from '../Pendencia.astro';
import Button from '../Button.astro';

const lista = faq.filter((f) => f.ativo);
---

<section id="duvidas" class="section faq" aria-labelledby="faq-titulo">
  <div class="container faq__grid">
    <header class="faq__head">
      <span class="kicker">{faqIntro.kicker}</span>
      <h2 id="faq-titulo" class="h2">{faqIntro.titulo}</h2>
      <p class="faq__foot">{faqIntro.rodape}</p>
      <Button whatsapp="Oi, Dra. Amanda! Vim pelo site e tenho uma dúvida." variant="text">Mandar minha dúvida</Button>
    </header>

    <div class="faq__list">
      {
        lista.map((f) => (
          <details class="faq__item">
            <summary>
              <h3>{f.pergunta}</h3>
              <span class="faq__icon" aria-hidden="true" />
            </summary>
            <div class="faq__answer">
              <p>{f.resposta}</p>
              <Pendencia texto={f.validar} />
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    background: var(--petroleo-profundo);
    color: var(--branco);
  }
  .faq .kicker {
    color: #bfe3e9;
  }
  .faq h2,
  .faq h3 {
    color: var(--branco);
  }
  .faq :global(.btn--text) {
    color: var(--branco);
  }
  .faq :global(:focus-visible) {
    outline-color: var(--branco);
  }

  .faq__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: 24px;
    align-items: start;
  }
  .faq__head {
    grid-column: 1 / span 4;
    position: sticky;
    top: calc(var(--header-h) + 32px);
  }
  .faq__foot {
    margin-top: 28px;
    margin-bottom: 4px;
    color: rgb(255 255 255 / 0.85);
  }
  .faq__list {
    grid-column: 6 / span 7;
    border-top: 1px solid rgb(255 255 255 / 0.35);
  }
  .faq__item {
    border-bottom: 1px solid rgb(255 255 255 / 0.35);
  }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding-block: 24px;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item h3 {
    font-size: clamp(1.125rem, 1.02rem + 0.4vw, 1.35rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }
  .faq__icon {
    position: relative;
    flex: none;
    width: 16px;
    height: 16px;
  }
  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    inset: 7px 0 auto;
    height: 2px;
    background: var(--branco);
    transition: transform 300ms var(--ease);
  }
  .faq__icon::after {
    transform: rotate(90deg);
  }
  .faq__item[open] .faq__icon::after {
    transform: rotate(0);
  }
  .faq__answer {
    padding-bottom: 28px;
    max-width: 40rem;
    color: rgb(255 255 255 / 0.92);
  }

  @media (max-width: 1023px) {
    .faq__grid {
      grid-template-columns: 1fr;
      row-gap: 40px;
    }
    .faq__head,
    .faq__list {
      grid-column: 1;
    }
    .faq__head {
      position: static;
    }
  }
</style>
