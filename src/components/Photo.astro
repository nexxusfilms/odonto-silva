---
/**
 * Fotografia. Sem `image`, mostra um placeholder identificado com a
 * orientação para a sessão de fotos. Quando a foto real existir, basta
 * importar o arquivo de src/assets/fotos e passar em `image`: o layout
 * não muda (a proporção é fixa).
 *
 * `frame` reproduz o recurso das peças do Manual: duas linhas em
 * azul-petróleo cruzando o canto da foto.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  label: string;
  hint?: string;
  ratio?: string;
  sizes?: string;
  frame?: 'tl' | 'bl' | 'br' | false;
  tilt?: number;
  eager?: boolean;
  class?: string;
}

const {
  image,
  alt,
  label,
  hint,
  ratio = '4 / 5',
  sizes = '(min-width: 1024px) 45vw, 100vw',
  frame = false,
  tilt = 0,
  eager = false,
  class: className = '',
} = Astro.props;
---

<figure
  class:list={['photo', frame && `photo--frame-${frame}`, className]}
  style={`--ratio: ${ratio}; --tilt: ${tilt}deg;`}>
  <div class="photo__inner">
    {
      image ? (
        <Picture
          src={image}
          alt={alt}
          widths={[480, 768, 1080, 1440]}
          sizes={sizes}
          formats={['avif', 'webp']}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      ) : (
        <div class="photo__placeholder" role="img" aria-label={`Espaço reservado: ${alt}`}>
          <span class="photo__label">[{label}]</span>
          {hint && <span class="photo__hint">{hint}</span>}
        </div>
      )
    }
  </div>
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    transform: rotate(var(--tilt));
  }
  .photo__inner {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--nevoa-azul);
  }
  .photo__inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: clamp(16px, 3vw, 28px);
    background:
      repeating-linear-gradient(135deg, transparent 0 22px, rgb(101 174 186 / 0.13) 22px 23px),
      var(--nevoa-azul);
  }
  .photo__label {
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--petroleo-profundo);
  }
  .photo__hint {
    max-width: 34ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--petroleo-profundo);
    opacity: 0.85;
  }

  /* Linhas cruzando o canto (Manual da Marca, páginas 2 e 4) */
  .photo[class*='photo--frame']::before,
  .photo[class*='photo--frame']::after {
    content: '';
    position: absolute;
    z-index: 1;
    background: var(--petroleo);
    pointer-events: none;
  }
  .photo--frame-tl::before {
    height: 6px;
    left: -7%;
    width: 62%;
    top: -14px;
    transform: rotate(-1.2deg);
  }
  .photo--frame-tl::after {
    width: 6px;
    top: -9%;
    height: 72%;
    left: -14px;
    transform: rotate(1deg);
  }
  .photo--frame-bl::before {
    height: 6px;
    left: -9%;
    width: 64%;
    bottom: -16px;
    transform: rotate(1.5deg);
  }
  .photo--frame-bl::after {
    width: 6px;
    bottom: -12%;
    height: 66%;
    left: -12px;
    transform: rotate(2deg);
  }
  .photo--frame-br::before {
    height: 6px;
    right: -8%;
    width: 58%;
    bottom: -15px;
    transform: rotate(-1.4deg);
  }
  .photo--frame-br::after {
    width: 6px;
    bottom: -10%;
    height: 60%;
    right: -13px;
    transform: rotate(-1deg);
  }
</style>
