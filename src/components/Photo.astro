---
/**
 * Fotografia. Sem `image`, mostra um placeholder identificado com a
 * orientação para a sessão de fotos. Quando a foto real existir, basta
 * importar o arquivo de src/assets/fotos e passar em `image`: o layout
 * não muda (a proporção é fixa).
 *
 * `frame` coloca o símbolo do logo (as duas formas de dente, petróleo
 * atrás e rosa na frente) sobre um canto da foto.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  label: string;
  hint?: string;
  ratio?: string;
  sizes?: string;
  frame?: 'tl' | 'bl' | 'br' | false;
  tilt?: number;
  eager?: boolean;
  class?: string;
}

const {
  image,
  alt,
  label,
  hint,
  ratio = '4 / 5',
  sizes = '(min-width: 1024px) 45vw, 100vw',
  frame = false,
  tilt = 0,
  eager = false,
  class: className = '',
} = Astro.props;
---

<figure
  class:list={['photo', frame && `photo--frame-${frame}`, className]}
  style={`--ratio: ${ratio}; --tilt: ${tilt}deg;`}>
  {
    frame && (
      <svg class="photo__mark" viewBox="0 0 120 110" aria-hidden="true">
        <path
          class="photo__mark-petroleo"
          d="M10 14C24 4 52 2 64 6c8 3 9 12 6 26-5 24-16 52-30 64-9 8-19 4-24-8C8 70 2 44 3 28c0-6 2-11 7-14Z"
        />
        <path
          class="photo__mark-rosa"
          d="M104 8c8 2 11 9 11 20 0 26-4 54-12 68-5 9-13 11-21 5C66 89 46 68 38 52c-4-8-2-15 6-20 16-10 42-22 54-24 2 0 4 0 6 0Z"
        />
      </svg>
    )
  }
  <div class="photo__inner">
    {
      image ? (
        <Picture
          src={image}
          alt={alt}
          widths={[480, 768, 1080, 1440]}
          sizes={sizes}
          formats={['avif', 'webp']}
          loading={eager ? 'eager' : 'lazy'}
          fetchpriority={eager ? 'high' : 'auto'}
        />
      ) : (
        <div class="photo__placeholder" role="img" aria-label={`Espaço reservado: ${alt}`}>
          <span class="photo__label">[{label}]</span>
          {hint && <span class="photo__hint">{hint}</span>}
        </div>
      )
    }
  </div>
</figure>

<style>
  .photo {
    position: relative;
    margin: 0;
    transform: rotate(var(--tilt));
  }
  .photo__inner {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--nevoa-azul);
  }
  .photo__inner :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .photo__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 6px;
    padding: clamp(16px, 3vw, 28px);
    background:
      repeating-linear-gradient(135deg, transparent 0 22px, rgb(101 174 186 / 0.13) 22px 23px),
      var(--nevoa-azul);
  }
  .photo__label {
    font-family: var(--f-titulo);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    color: var(--petroleo-profundo);
  }
  .photo__hint {
    max-width: 34ch;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--petroleo-profundo);
    opacity: 0.85;
  }

  /* Símbolo do logo sobre um canto da foto. O deslocamento acompanha o
     tamanho do símbolo, para ele não invadir textos e botões ao redor. */
  .photo__mark {
    --m: clamp(64px, 22%, 132px);
    --fora: calc(var(--m) * -0.3);
    position: absolute;
    z-index: 2;
    width: var(--m);
    height: auto;
    pointer-events: none;
  }
  .photo__mark-petroleo {
    fill: var(--petroleo);
  }
  .photo__mark-rosa {
    fill: var(--rosa);
  }
  .photo--frame-tl .photo__mark {
    top: var(--fora);
    left: var(--fora);
    transform: rotate(-8deg);
  }
  .photo--frame-bl .photo__mark {
    bottom: var(--fora);
    left: var(--fora);
    transform: rotate(-18deg);
  }
  .photo--frame-br .photo__mark {
    bottom: var(--fora);
    right: var(--fora);
    transform: rotate(10deg);
  }
  /* Até o tablet a foto pode encostar na borda da tela: o símbolo sai menos. */
  @media (max-width: 1023px) {
    .photo__mark {
      --fora: calc(var(--m) * -0.12);
    }
  }
</style>
