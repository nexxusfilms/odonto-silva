---
import '@fontsource-variable/inter/wght.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/caveat/latin-500.css';
import '../styles/base.css';
import { site, isFilled } from '../config/site';
import { flags } from '../config/flags';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title?: string;
  description?: string;
  schemas?: object[];
  noindex?: boolean;
}

const { title = site.seo.titulo, description = site.seo.descricao, schemas = [], noindex = false } = Astro.props;
// Sem barra no final, igual ao sitemap.xml.
const canonical = new URL(Astro.url.pathname.replace(/(.)\/$/, '$1'), site.url).toString();
const ogImage = new URL(site.seo.ogImage, site.url).toString();
const gtmId = isFilled(site.rastreamento.gtmId) ? site.rastreamento.gtmId : null;
// O aviso de cookies só faz sentido com o GTM ativo; na prévia ele aparece para aprovação.
const avisoCookies = !!gtmId || flags.mostrarPendencias;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* Enquanto houver pendências, o site não aparece no Google. */}
    {(noindex || flags.mostrarPendencias) && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.marca} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>
    {
      avisoCookies && (
        // Consent Mode v2: tudo negado até a pessoa escolher. Precisa vir antes do GTM.
        // A chave é a mesma de src/lib/consentimento.ts.
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag() {
            dataLayer.push(arguments);
          }
          gtag('consent', 'default', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            functionality_storage: 'granted',
            security_storage: 'granted',
            wait_for_update: 500,
          });
          gtag('set', 'ads_data_redaction', true);
          try {
            var c = JSON.parse(localStorage.getItem('odontosilva_consentimento_v1'));
            if (c && Date.now() - Date.parse(c.data) < 31536000000) {
              var v = function (ok) {
                return ok ? 'granted' : 'denied';
              };
              gtag('consent', 'update', {
                analytics_storage: v(c.estatistica),
                ad_storage: v(c.anuncios),
                ad_user_data: v(c.anuncios),
                ad_personalization: v(c.anuncios),
              });
            }
          } catch (e) {}
        </script>
      )
    }
    {
      gtmId && (
        <script is:inline define:vars={{ gtmId }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s);
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      )
    }
  </head>
  <body>
    {
      gtmId && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
            title="Google Tag Manager"
          />
        </noscript>
      )
    }
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    {avisoCookies && <CookieConsent />}

    <script>
      import { iniciarRastreamento } from '../lib/tracking';
      iniciarRastreamento();
    </script>

    <script>
      // Reveal discreto ao rolar. Sem JS, o conteúdo aparece normalmente.
      const items = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
